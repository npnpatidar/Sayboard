    <color name="colorAccent">#FF9800</color><!-- Orange 500 -->

    <color name="colorOnPrimary">#377A00</color>

    <color name="materialYouForegroundLight">@color/colorOnPrimary</color>
    <color name="materialYouForegroundDark">@color/colorOnPrimary</color>
    <color name="materialYouForeground">@color/materialYouForegroundLight</color>
</resources>

    <!--  Logic Preferences  -->
    <string name="logic_keep_screen_awake_title">Keep screen awake</string>
    <string name="logic_listen_immediately_title">Listen immediately</string>
    <string name="logic_listen_immediately_summary">Start listening immediately when the recognizer is ready.</string>
    <string name="logic_auto_switch_back_title">Auto switch back</string>
    <string name="logic_auto_switch_back_summary">Automatically switch to previous keyboard whenever the keyboard is hidden.</string>
    <string name="logic_keep_model_in_ram_title">Keep the model in RAM (when closed)</string>
    <string name="logic_keep_model_in_ram_summary">Keeps models in RAM for instant switches; each uses ~100 MB–1 GB. Turning this off frees every model — the per-model pins below only apply while it is on.</string>
    <string name="logic_vad_auto_stop_title">Stop recording on silence</string>
    <string name="logic_vad_auto_stop_summary">For Whisper/Parakeet: end the take automatically after a second of silence instead of a second mic tap.</string>
    <string name="logic_auto_switch_model_title">Match model to field language</string>
    <string name="logic_auto_switch_model_summary">Automatically select the model matching the text field language, when the app reports one.</string>
    <string name="logic_remember_locale_title">Remember language per app</string>
    <string name="logic_remember_locale_summary">Re-apply the language last used in each app when Sayboard opens there.</string>
    <string name="logic_keep_alive_title">Keep alive in background</string>
    <string name="logic_keep_alive_summary">Keep the model in memory with a permanent notification, so switching keyboards stays instant. Uses RAM, no battery drain while idle.</string>

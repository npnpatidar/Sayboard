<?xml version="1.0" encoding="UTF-8"?>
<lint>
     <!-- Translations are crowdsourced, we can't have 100% coverage at all times -->
    <issue id="MissingTranslation" severity="ignore" />

    <!-- Weblate doesn't handle these yet: https://github.com/WeblateOrg/weblate/issues/7520 -->
    <issue id="MissingQuantity" severity="error">
        <ignore path="src/main/res/values-cs" />
        <ignore path="src/main/res/values-lt" />
        <ignore path="src/main/res/values-sk" />
    </issue>

    <!-- Design-reviewed: theme primaries resolve per-theme dynamic resources
         (materialYouForegroundDark vs Light) plus distinct fallbacks, so no
         background value ever pairs with two on-colors at runtime. The check
         cannot resolve colorResource() values and false-positives on the
         shared-val structure; warnings keep it visible without failing CI. -->
    <issue id="ConflictingOnColor" severity="warning" />
</lint>